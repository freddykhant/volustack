# Copy this file to ".env" and fill it in. ".env" is gitignored; this file is
# committed, so never put real secrets here. When adding a variable, update the
# schema in "/src/env.js" too.

# Better Auth
# Secret used by Better Auth. Required in production, optional in development.
BETTER_AUTH_SECRET=""
# Base URL, read by better-auth directly (not validated in src/env.js). Optional locally.
# BETTER_AUTH_URL="http://localhost:3000"

# Better Auth Google OAuth
# Redirect URI to register: http://localhost:3000/api/auth/callback/google
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/mesodapt"
# Prisma's directUrl (schema.prisma). Required by Prisma; for a local database use
# the same value as DATABASE_URL. On Neon, the non-pooled connection string.
DATABASE_URL_UNPOOLED="postgresql://postgres:password@localhost:5432/mesodapt"

# Coach box (Anthropic). Optional: with no key the coach box is not rendered and
# the week board works as before.
ANTHROPIC_API_KEY=""
# Model that parses coach messages. Default: claude-haiku-4-5-20251001
# COACH_MODEL="claude-haiku-4-5-20251001"

# Jev judgement (TypeSafe). Optional: with no key the engine's deterministic pick
# always stands (reschedule, progression, replacement-option order).
TYPESAFE_API_KEY=""
# Must be a pinned version (jev-X.Y.Z); jev-latest / jev-preview are rejected.
# Default: jev-1.13.0
# JEV_MODEL="jev-1.13.0"
